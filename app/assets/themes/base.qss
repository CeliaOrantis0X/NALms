/* ===== 全局 ===== */
QDialog {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: "Segoe UI", "Microsoft YaHei";
    font-size: 13px;
}

/* ===== 分组卡片 ===== */
QGroupBox {
    border: 1px solid #333;
    border-radius: 8px;
    margin-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #9cdcfe;
    font-weight: bold;
}

/* ===== 输入类 ===== */
QLineEdit,
QTextEdit,
QComboBox {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px;
}

/* ===== 按钮 ===== */
QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #3a3a3a;
}

QPushButton:pressed {
    background-color: #0e639c;
}

/* ===== 插图 ===== */
QLabel#Avatar {
    background-color: #2d2d2d;
    border: 1px dashed #555;
    border-radius: 6px;
}

QLabel.storyHint {
    color: #777;
    font-style: italic;
}

QStackedWidget {
    border: 1px solid #444;
    border-radius: 6px;
    background-color: #1e1e1e;
}

QLabel[class="cardId"] {
    color: #9B7FA0;
    font-size: 10pt;
    font-weight: 600;

    padding-right: 4px;
}

/* =====================================
   Content Tabs
===================================== */

QPushButton#contentTab {
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(220,180,210,0.45);
    border-radius: 10px;

    padding: 6px 14px;

    color: #7a6485;
    font-weight: 600;
}

QPushButton#contentTab:hover {
    background: rgba(255,255,255,0.78);
    border-color: rgba(210,170,220,0.7);
}

/* 当前选中页 */
QPushButton#contentTab:checked {

    background: qlineargradient(
        x1:0,y1:0,x2:0,y2:1,
        stop:0 #f4ddff,
        stop:1 #e8cbff
    );

    border: 1px solid #c79ae8;

    color: #4d2f5f;

    font-weight: bold;
}

/* 按下动画感 */
QPushButton#contentTab:pressed {
    padding-top: 7px;
    padding-bottom: 5px;
}

